# Theta EdgeCloud Hermes Skill example environment
# Copy only the variables needed for the commands you plan to use.
# Never commit real values.

# Controller / deployment / project APIs
THETA_EC_API_KEY=
THETA_EC_PROJECT_ID=

# Organization balance
THETA_ORG_ID=

# On-demand inference/media APIs
# Set one of these:
THETA_ONDEMAND_API_TOKEN=
THETA_ONDEMAND_API_KEY=
THETA_API_KEY=

# Dedicated OpenAI-compatible inference endpoint
THETA_INFERENCE_ENDPOINT=
THETA_INFERENCE_AUTH_TOKEN=
# Or use basic auth instead of token auth:
THETA_INFERENCE_AUTH_USER=
THETA_INFERENCE_AUTH_PASS=

# Theta Video API
THETA_VIDEO_SA_ID=
THETA_VIDEO_SA_SECRET=

# Safer first-run mode for mutating/paid commands
THETA_DRY_RUN=1
